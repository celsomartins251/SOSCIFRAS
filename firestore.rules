rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sos_cifras_groups/{groupCode} {
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.leader == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      allow get: if request.auth != null;
      allow list: if false;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.owner
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.leader == resource.data.leader
        )
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;

      match /activity/{itemId} {
        function isMember() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/sos_cifras_groups/$(groupCode)).data.members;
        }
        function isLeader() {
          return request.auth != null
            && request.auth.uid == get(/databases/$(database)/documents/sos_cifras_groups/$(groupCode)).data.leader;
        }
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.createdBy == request.auth.uid
          && (request.resource.data.type != 'event' || isLeader());
        allow update, delete: if isMember() && (
          (resource.data.type == 'event' && isLeader())
          || (resource.data.type != 'event'
              && (resource.data.createdBy == request.auth.uid || isLeader()))
        );
      }
    }
  }
}